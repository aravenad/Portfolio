---
import BaseLayout from "../layouts/BaseLayout.astro";
import TestButton from "../components/react/TestButton";
---

<BaseLayout
  title="Damien — Portfolio"
  description="Portfolio de Damien, étudiant et développeur informatique."
>
  <main>
    <section
      class="mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-6"
    >
      <p
        class="mb-4 text-sm font-medium uppercase tracking-widest text-zinc-400"
      >
        Développeur
      </p>

      <h1 class="max-w-4xl text-5xl font-bold tracking-tight sm:text-7xl">
        Bonjour, moi c'est Damien.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-400">
        Étudiant en informatique, je développe des applications, des sites web
        et différents projets logiciels.
      </p>

      <div class="mt-10 flex gap-4">
        <a
          href="#projects"
          class="rounded-lg bg-white px-5 py-3 font-medium text-black transition hover:bg-zinc-200"
        >
          Voir mes projets
        </a>

        <a
          href="#contact"
          class="rounded-lg border border-zinc-700 px-5 py-3 font-medium transition hover:bg-zinc-900"
        >
          Me contacter
        </a>
      </div>
      <div>
        <TestButton client:load />
      </div>
    </section>
  </main>
</BaseLayout>
